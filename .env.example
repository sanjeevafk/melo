# EchoRead/Melo configuration. Copy to .env and edit. Both MELO_ and ECHOREAD_
# prefixes are accepted; ECHOREAD_ is used here. Unset values fall back to defaults.

# --- Server ---
# ECHOREAD_PROFILE=cpu            # cpu | gpu
# ECHOREAD_HOST=127.0.0.1
# ECHOREAD_PORT=8000
# ECHOREAD_DATA_DIR=./data

# --- Speech to text (Voice queries / push-to-talk) ---
# ECHOREAD_STT_PROVIDER=phonon    # phonon | whisper

# --- Batch Speech to text (Audiobook ingestion) ---
# local: uses the local STT model (faster-whisper)
# ECHOREAD_BATCH_STT_PROVIDER=local
#
# qwen3_asr: self-hosted or remote Qwen3-ASR vLLM / OpenAI-compatible endpoint.
# Fast batch transcription with sub-second per hour throughput.
# ECHOREAD_BATCH_STT_PROVIDER=qwen3_asr
# ECHOREAD_QWEN3_ASR_ENDPOINT=http://localhost:8000/v1
# ECHOREAD_QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# ECHOREAD_QWEN3_ASR_API_KEY=
# ECHOREAD_QWEN3_ASR_TIMEOUT=300

# --- LLM (pick ONE provider) ---
# ollama: local or LAN Ollama server (no API key needed)
# ECHOREAD_LLM_PROVIDER=ollama
# ECHOREAD_LLM_ENDPOINT=http://localhost:11434
# ECHOREAD_LLM_MODEL=gemma4:e2b

# openai-compatible: any hosted or local OpenAI-compatible server.
# Works with Groq (free tier), OpenRouter, OpenAI, Together, LM Studio,
# llama.cpp server, vLLM, ... — point ENDPOINT at the server and set the key.
# ECHOREAD_LLM_PROVIDER=openai
# Groq (free):    https://api.groq.com/openai/v1
# OpenRouter:     https://openrouter.ai/api/v1
# OpenAI:         https://api.openai.com/v1
# LM Studio:      http://localhost:1234/v1
# llama.cpp:      http://localhost:8080/v1
# ECHOREAD_LLM_ENDPOINT=https://api.groq.com/openai/v1
# ECHOREAD_LLM_API_KEY=gsk_...
# ECHOREAD_LLM_MODEL=llama-3.3-70b-versatile

# llama_cpp: fully offline, uses the GGUF fetched by `make models`
# (Qwen2.5-1.5B-Instruct Q4_K_M on cpu profile).
# ECHOREAD_LLM_PROVIDER=llama_cpp

# --- Misc ---
# ECHOREAD_LLM_THINK=false        # emit reasoning tokens (Ollama only)
# ECHOREAD_LLM_TIMEOUT=60
# ECHOREAD_TEST_MODE=false
